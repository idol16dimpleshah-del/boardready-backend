# Copy to .env and fill in real values before running in any shared/production
# environment. Never commit the real .env file (it's gitignored).

# HMAC signing secret for auth tokens. MUST be an explicit, long random value
# in production (e.g. `openssl rand -hex 32`) — config.js refuses to start in
# production with no AUTH_SECRET set at all (fail-closed; see config.js).
# In development/test, leaving this unset is fine: a fresh random secret is
# generated for that process only, with a console warning.
AUTH_SECRET=

# Port the HTTP server listens on. Defaults to 4000 if unset. On Railway (and
# most hosting platforms) this is injected automatically — do not set it
# manually in a Railway service's variables.
PORT=4000

# Set to production on a real deployment (enables the AUTH_SECRET fail-closed
# check above, and disables the "development" defaults).
NODE_ENV=production

# --- Database engine selection (Phase 6, docs/phase-6-postgres-cutover-plan.md) ---
# "sqlite" (default, if unset) uses the local node:sqlite file at DB_PATH (or
# boardready.db). Set to "postgres" for Stage 6C+ staging/production, backed
# by DATABASE_URL below.
DB_ENGINE=postgres

# Required when DB_ENGINE=postgres. On Railway, add the Postgres plugin to
# this service's project and reference its connection string as
# ${{Postgres.DATABASE_URL}} in this service's variables — Railway resolves
# that reference automatically; you never need to copy/paste the actual
# connection string by hand.
DATABASE_URL=postgres://user:password@host:5432/boardready

# Comma-separated CORS allowlist (Phase 5, docs/phase-5-security-audit-report.md
# item 6). Leave unset/empty for a first staging pass — the frontend is served
# from the same origin as the API (see server.js's tryServeStatic), so no
# cross-origin requests exist yet. Only needed if a separate frontend
# deployment (a different origin) will call this API directly.
# ALLOWED_ORIGINS=https://your-frontend-domain.example
